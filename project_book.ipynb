    "#converting text into vectores with TF-IDF\n",
    "#rows = books \n",
    "#columns = words \n",
    "#values = score \n",
    "tfidf = TfidfVectorizer()\n",
    "result = tfidf.fit_transform(df)\n",
    "\n",
    "print('\\nidf values:')\n",
    "for ele1, ele2 in zip(tfidf.get_feature_names_out(), tfidf.idf_):\n",
    "    print(ele1, ':', ele2)\n",
    "#unique word is a feature \n",
    "#common = lower value \n",
    "#rare = higher value \n",
    "\n",
    "#vec\n",
    "vec.fit_transform(df).toarray()\n",
    "vec.get_feature_names_out()\n",
    "\n",
    "\n",
    "print('\\nWord indexes:')\n",
    "print(tfidf.vocabulary_)\n",
    "#column index\n",
    "print('\\ntf-idf value:')\n",
    "print(result)\n",
    "print('\\ntf-idf values in matrix form:')\n",
    "print(result.toarray())\n",
    "# showing the full TD-IDF"
